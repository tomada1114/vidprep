{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$(git rev-parse --show-toplevel)/.agents/hooks/guard.py\"",
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$(git rev-parse --show-toplevel)/.agents/hooks/format.py\"",
            "timeout": 60
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "uv run --script \"$(git rev-parse --show-toplevel)/.agents/hooks/stop_check.py\"",
            "timeout": 180
          }
        ]
      }
    ]
  }
}
